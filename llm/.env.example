# ==============================================================================
# Local LLM Environment Configuration (.env.example)
#
# Copy this file to .env to customize settings for your local machine.
# Note: A .env file is optional; safe defaults are used if omitted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT SETTINGS (Consumed by Python LlamaCppClient at runtime)
# ------------------------------------------------------------------------------
# Base URL for the running llama.cpp HTTP server
LLM_BASE_URL=http://127.0.0.1:8080

# Connection timeout in seconds (establishing connection to server)
LLM_CONNECT_TIMEOUT=5.0

# Generation timeout in seconds (waiting for response generation to complete)
LLM_GENERATION_TIMEOUT=120.0

# Optional API key (only if llama-server was started with --api-key)
# LLM_API_KEY=your-local-api-key-here

# Sampling temperature (0.0 to 2.0; lower = more deterministic)
LLM_TEMPERATURE=0.7

# Top-p (nucleus sampling threshold, 0.0 < top_p <= 1.0)
LLM_TOP_P=0.9

# Maximum new tokens to generate per response
LLM_MAX_TOKENS=512

# Qwen3 thinking mode control:
# - set to 'false' to request direct, concise responses without chain-of-thought
# - set to 'true' to explicitly enable thinking
# - leave unset/commented out to follow default model template behavior
LLM_ENABLE_THINKING=false

# Reasoning token budget for llama-server (-1 = unrestricted, 0 = suppress thinking)
# LLM_REASONING_BUDGET=0

# ------------------------------------------------------------------------------
# 2. SERVER LAUNCH SETTINGS (Configured when starting llama-server.exe)
#
# IMPORTANT: These settings MUST be passed as flags when launching llama-server.
# The Python HTTP client CANNOT modify context length (-c) or GPU layers (-ngl)
# dynamically after the server process has started.
# ------------------------------------------------------------------------------
LLM_MODEL_NAME=ggml-org/Qwen3-1.7B-GGUF:Q4_K_M

# Path to the local .gguf model file or Hugging Face repo specifier
# Example: -hf ggml-org/Qwen3-1.7B-GGUF:Q4_K_M
LLM_MODEL_PATH=

# Context window size (-c / --ctx-size).
# Recommended default: 2048 (or 4096).
LLM_CONTEXT_LENGTH=2048

# Number of layers to offload to GPU (-ngl / --n-gpu-layers).
# For Qwen3-1.7B (~1.3 GB file size), all layers easily fit into GPU memory (-ngl 99).
LLM_N_GPU_LAYERS=99

# Server host interface (--host). Keep 127.0.0.1 for local privacy.
LLM_HOST=127.0.0.1

# Server port (--port). Default: 8080.
LLM_PORT=8080

# ------------------------------------------------------------------------------
# 3. DATABASE SETTINGS (PostgreSQL with pgvector extension)
#
# Single database instance shared by RAG assistant and future simulator backend.
# Replace 'postgres:postgres' with your local PostgreSQL credentials.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/plc_simulator

# ------------------------------------------------------------------------------
# 4. RAG PIPELINE & EMBEDDINGS SETTINGS
# ------------------------------------------------------------------------------
# Lightweight local Sentence Transformers model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Embedding dimension (384 for all-MiniLM-L6-v2)
EMBEDDING_DIMENSION=384

# Max passages retrieved per question
RAG_TOP_K=5

# Minimum cosine similarity threshold (range 0.0 to 1.0)
RAG_SIMILARITY_THRESHOLD=0.35

# Chunk size and overlap in characters (~700 tokens / ~120 tokens)
RAG_CHUNK_SIZE=2400
RAG_CHUNK_OVERLAP=400

# ------------------------------------------------------------------------------
# 5. FASTAPI BACKEND & CORS SETTINGS
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated allowlist of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
